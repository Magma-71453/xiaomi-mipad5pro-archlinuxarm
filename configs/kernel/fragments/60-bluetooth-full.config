# 蓝牙补全：上游 postmarketOS config 关掉了 RFCOMM/BNEP/扩展，
# 导致「适配器能出现但一半功能不可用」。详见 bug.md B-049。
#
#   RFCOMM  蓝牙耳机麦克风(HFP/HSP)、串口、部分手柄、OBEX 文件传输
#   BNEP    蓝牙网络共享(PAN/tethering)
#   MSFTEXT Windows 系鼠标/键盘的电池与快速重连扩展
#   AOSPEXT Android 系外设（部分手柄/耳机）的扩展
#
# bluetoothd 在缺失这些时的报错（真机实测）：
#   profiles/network/bnep.c:bnep_init() kernel lacks bnep-protocol support
#   src/profile.c:ext_start_servers() RFCOMM server failed for Hands-Free unit:
#       socket(STREAM, RFCOMM): Protocol not supported (93)

# RFCOMM：耳机麦克风 / 串口 / OBEX
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y

# BNEP：蓝牙网络共享
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y

# HID：键盘/鼠标/手柄（上游已是 m，这里显式钉住，避免被上游改动带跑）
CONFIG_BT_HIDP=m

# 厂商扩展：电池上报、快速重连
CONFIG_BT_MSFTEXT=y
CONFIG_BT_AOSPEXT=y

# 调试：btmon 之外的 debugfs 视图（hci0/ 下可看连接状态）
CONFIG_BT_DEBUGFS=y
