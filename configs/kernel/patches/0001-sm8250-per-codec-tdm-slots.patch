+/* elish speaker TDM link tunables.
+ *
+ * CS35L41_SP_FRAME_RX_SLOT (0x4820) is not a TDM slot index but an ASP RX
+ * channel selector: 0 selects the left channel, 2 selects the right one.  The
+ * machine driver never programmed it, so every amplifier kept its power-on
+ * default and all eight speakers played the left channel.
+ *
+ * The device tree lists the T* amplifiers (i2c3, left side of the tablet)
+ * first and the B* amplifiers (i2c1, right side) last, hence the j < 4 split.
+ * The remaining parameters let the link be retuned with modprobe while
+ * bringing audio up.
+ *
+ *   modprobe snd_soc_sm8250 left_slot=0 right_slot=2
+ */
+static int left_slot = 0;
+module_param(left_slot, int, 0644);
+MODULE_PARM_DESC(left_slot, "RX channel select for the left-hand amplifiers (0 = left, 2 = right)");
+
+static int right_slot = 2;
+module_param(right_slot, int, 0644);
+MODULE_PARM_DESC(right_slot, "RX channel select for the right-hand amplifiers (0 = left, 2 = right)");
+
+static int tx_mask = 0;
+module_param(tx_mask, int, 0644);
+MODULE_PARM_DESC(tx_mask, "TDM TX slot mask (mask + 1 disables the override)");
+
+static int rx_mask = 3;
+module_param(rx_mask, int, 0644);
+MODULE_PARM_DESC(rx_mask, "TDM RX slot mask");
+
+static int tdm_slots = 8;
+module_param(tdm_slots, int, 0644);
+MODULE_PARM_DESC(tdm_slots, "TDM slots per frame");
+
+static int tdm_width = 32;
+module_param(tdm_width, int, 0644);
+MODULE_PARM_DESC(tdm_width, "TDM slot width in bits");
+
+static int amp_slot_mode = 0;
+module_param(amp_slot_mode, int, 0644);
+MODULE_PARM_DESC(amp_slot_mode, "0 = left/right halves, 1 = one slot per amplifier");
+
