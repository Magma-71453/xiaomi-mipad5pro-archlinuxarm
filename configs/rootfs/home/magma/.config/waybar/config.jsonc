{
  "layer": "top",
  "fixed-center": true,
  "position": "top",
  "height": 38,
  "spacing": 6,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": ["wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "battery", "pulseaudio", "network", "bluetooth", "custom/power"],

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "icon-theme": "hicolor",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "fullscreen",
    "all-outputs": true,
    "active-first": true
  },

  "clock": {
    "format": "{:%m/%d %H:%M:%S}",
    "tooltip": false
  },

  "tray": {
    "icon-size": 18,
    "spacing": 10,
    "reverse-direction": true
  },

  "battery": {
    "bat": "bq27z561-0",
    "interval": 30,
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": "\uf0e7 {capacity}%",
    "format-discharging": "{icon} {capacity}%",
    "format-full": "\uf240 {capacity}%",
    "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    "tooltip-format": "电量 {capacity}%"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "{icon}",
    "format-icons": { "default": ["\uf026", "\uf027", "\uf028"] },
    "on-click": "kitty -1 -e alsamixer",
    "tooltip-format": "音量 {volume}%"
  },

  "network": {
    "format-wifi": "\uf1eb",
    "format-ethernet": "\uf0ac",
    "format-disconnected": "\uf00d",
    "interval": 30,
    "tooltip-format-wifi": "{essid} {signalStrength}%",
    "on-click": "kitty -1 -e nmtui"
  },

  "bluetooth": {
    "format": "\uf293",
    "format-disabled": "\uf293",
    "format-connected": "\uf293",
    "interval": 30,
    "tooltip-format": "{controller_alias}",
    "on-click": "kitty -1 -e bluetoothctl"
  },

  "custom/power": {
    "format": "\uf011",
    "tooltip": false,
    "on-click": "/usr/local/bin/mango-powermenu"
  }
}
