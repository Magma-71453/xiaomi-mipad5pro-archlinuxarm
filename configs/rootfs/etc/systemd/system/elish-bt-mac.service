[Unit]
Description=Give the QCA6390 Bluetooth controller a usable BD_ADDR (it reports 00:00:00:00:5A:AD)
# see bug.md B-047
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=150
ExecStart=/usr/local/bin/elish-bt-mac

[Install]
WantedBy=multi-user.target
