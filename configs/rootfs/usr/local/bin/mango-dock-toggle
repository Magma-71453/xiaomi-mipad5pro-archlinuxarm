#!/usr/bin/env python3
"""mango-dock-toggle -- three-finger swipe up: flip the dock by hand.

Hides the dock when it is visible, shows it when it is hidden, and records the
manual override that mango-dock-autohide must respect:

  visible -> hidden   state = manual-hidden   (sticky: window detection is off
                                               until the next swipe)
  hidden  -> visible  state = manual-shown N  (N = whether a visible window was
                                               fullscreen/maximised right now;
                                               mango-dock-autohide consumes it
                                               and returns to auto, holding the
                                               dock shown until the window state
                                               actually moves away from N)

Idempotent by construction: the target is derived from mango-dock's own report
($XDG_RUNTIME_DIR/mango-dock.geom, last field = hidden), and a signal is only
sent when the dock is not already in the wanted state.
"""
import fcntl
import json
import os
import signal
import subprocess
import sys

MMSG = "/usr/bin/mmsg"
SIG_HIDE = signal.SIGUSR1
SIG_SHOW = signal.SIGUSR2


def rt_dir():
    env = os.environ.get("XDG_RUNTIME_DIR")
    if env and os.path.isdir(env):
        return env
    return "/run/user/%d" % os.getuid()


RT = rt_dir()
STATE = os.path.join(RT, "mango-dock-autohide.state")
GEOM = os.path.join(RT, "mango-dock.geom")
LOCK = os.path.join(RT, "mango-dock-toggle.lock")


def geom_hidden():
    try:
        with open(GEOM) as f:
            return int(f.read().split()[-1])
    except (OSError, ValueError, IndexError):
        return None


def write_state(value):
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        f.write(value + "\n")
    os.replace(tmp, STATE)


def mango_socket():
    sig = os.environ.get("MANGO_INSTANCE_SIGNATURE")
    if sig and os.path.exists(sig):
        return sig
    try:
        names = sorted(os.listdir(RT))
    except OSError:
        return None
    for n in names:
        if n.startswith("mango-") and n.endswith(".sock"):
            return os.path.join(RT, n)
    return None


def window_flag():
    """1 when a visible client is fullscreen/maximised, 0 when not, None if
    mango cannot be asked -- the state then simply carries no hint."""
    sock = mango_socket()
    if not sock:
        return None
    env = dict(os.environ)
    env["MANGO_INSTANCE_SIGNATURE"] = sock
    env.setdefault("XDG_RUNTIME_DIR", RT)
    try:
        p = subprocess.run([MMSG, "get", "all-clients"], capture_output=True,
                           env=env, text=True, timeout=3)
        clients = json.loads(p.stdout).get("clients") or []
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None
    return 1 if any(c.get("is_visible") and (c.get("is_fullscreen") or c.get("is_maximized"))
                    for c in clients) else 0


def dock_pids():
    pids = []
    try:
        entries = os.listdir("/proc")
    except OSError:
        return pids
    for e in entries:
        if not e.isdigit():
            continue
        try:
            with open("/proc/%s/cmdline" % e, "rb") as f:
                args = f.read().split(b"\0")
        except OSError:
            continue
        for a in args[:2]:
            if os.path.basename(a.decode("utf-8", "replace")) == "mango-dock":
                pids.append(int(e))
                break
    return pids


def main():
    try:
        lock = open(LOCK, "w")
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0                # another swipe is still being handled

    hidden = geom_hidden()
    want_hide = not hidden if hidden is not None else True
    if want_hide:
        write_state("manual-hidden")
    else:
        flag = window_flag()
        write_state("manual-shown" + ("" if flag is None else " %d" % flag))
    if hidden is None or hidden != (1 if want_hide else 0):
        sig = SIG_HIDE if want_hide else SIG_SHOW
        for pid in dock_pids():
            try:
                os.kill(pid, sig)
            except OSError:
                pass
    print("mango-dock-toggle: dock -> %s" % ("hidden" if want_hide else "shown"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
