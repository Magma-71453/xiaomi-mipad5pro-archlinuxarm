#!/usr/bin/env python3
"""mango-keys — hardware key daemon (volume keys) for the Xiaomi Pad 5 Pro.

mango binds keys by keysym, but the gpio-keys volume key does not resolve to
XF86AudioRaiseVolume through the current keymap, so we read evdev directly:
KEY_VOLUMEUP (115) / KEY_VOLUMEDOWN (114) / KEY_MUTE (113) -> mango-volume.

Devices are rescanned every 2 s so hot-added keyboards work too.
"""
import glob
import os
import select
import struct
import subprocess
import sys
import time

EVENT = struct.Struct("llHHi")
EV_KEY = 1
KEY_VOLUMEUP, KEY_VOLUMEDOWN, KEY_MUTE = 115, 114, 113
ACTION = {KEY_VOLUMEUP: "up", KEY_VOLUMEDOWN: "down", KEY_MUTE: "mute"}


def open_devices():
    fds = {}
    for path in sorted(glob.glob("/dev/input/event*")):
        try:
            fds[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
        except OSError:
            continue
    return fds


def main():
    fds = open_devices()
    last_scan = time.time()
    print("mango-keys: watching %d devices" % len(fds), flush=True)
    while True:
        if time.time() - last_scan > 1:
            current = set(fds.values())
            for path in sorted(glob.glob("/dev/input/event*")):
                if path in current:
                    continue
                try:
                    fds[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
                except OSError:
                    pass
            last_scan = time.time()
        try:
            r, _, _ = select.select(list(fds.keys()), [], [], 0.5)
        except OSError:
            continue
        for fd in r:
            try:
                data = os.read(fd, EVENT.size * 32)
            except OSError:
                continue
            for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, etype, code, value = EVENT.unpack_from(data, off)
                if etype == EV_KEY and code in ACTION and value == 1:
                    subprocess.Popen(["/usr/local/bin/mango-volume", ACTION[code]])


if __name__ == "__main__":
    sys.exit(main())
